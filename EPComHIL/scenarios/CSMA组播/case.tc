{
  "projectName": "案例_CSMA组播",
  "version": "0.1.0",
  "createdAt": "2026-09-19T00:00:00.000Z",
  "nodes": [
    {
      "id": "hub",
      "name": "组播中心",
      "kind": "host",
      "x": 180,
      "y": 300,
      "apps": [
        { "id": "app_hub", "role": "CLIENT", "protocol": "CUSTOM", "port": 999, "peer": "mbr1", "interval": 0.5, "payloadSize": 48 }
      ],
      "stats": ["tx_packets", "pdr", "delay_mean", "delay_jitter"]
    },
    {
      "id": "sw",
      "name": "组播交换机",
      "kind": "switch",
      "x": 560,
      "y": 300
    },
    {
      "id": "mbr1",
      "name": "组播成员_1",
      "kind": "ied",
      "x": 940,
      "y": 100,
      "apps": [
        { "id": "app1", "role": "SERVER", "protocol": "CUSTOM", "port": 999 }
      ],
      "stats": ["rx_packets", "rx_bytes", "delay_mean", "delay_jitter"]
    },
    {
      "id": "mbr2",
      "name": "组播成员_2",
      "kind": "ied",
      "x": 940,
      "y": 500,
      "apps": [
        { "id": "app2", "role": "SERVER", "protocol": "CUSTOM", "port": 999 }
      ],
      "stats": ["rx_packets", "pdr"]
    }
  ],
  "links": [
    { "id": "l1", "kind": "csma", "nodeA": "hub", "nodeB": "sw", "dataRate": "100Mbps", "delay": "100us" },
    { "id": "l2", "kind": "csma", "nodeA": "sw", "nodeB": "mbr1", "dataRate": "100Mbps", "delay": "100us" },
    { "id": "l3", "kind": "csma", "nodeA": "sw", "nodeB": "mbr2", "dataRate": "100Mbps", "delay": "100us" }
  ],
  "protocols": [],
  "flows": [
    { "id": "f1", "type": "PERIODIC", "src": "hub", "dst": "mbr1", "interval": 0.5, "payloadSize": 48 },
    { "id": "f2", "type": "PERIODIC", "src": "hub", "dst": "mbr2", "interval": 0.5, "payloadSize": 48 }
  ],
  "faults": [],
  "halfPhysical": { "taps": [], "physicalNic": "" },
  "hil": { "timestepUs": 100 },
  "run": { "mode": "OFFLINE", "precise": false, "clockSource": "INTERNAL", "stopSeconds": 10, "syncMode": "HARD_LIMIT" }
}