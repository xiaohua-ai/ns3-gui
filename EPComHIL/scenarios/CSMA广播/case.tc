{
  "projectName": "案例_CSMA广播",
  "version": "0.1.0",
  "createdAt": "2026-09-19T00:00:00.000Z",
  "nodes": [
    {
      "id": "n_src",
      "name": "广播源_IED",
      "kind": "ied",
      "x": 160,
      "y": 300,
      "apps": [
        { "id": "app1", "role": "CLIENT", "protocol": "CUSTOM", "port": 502, "peer": "n_sink1", "interval": 0.5, "payloadSize": 64 }
      ],
      "stats": ["tx_packets", "rx_packets", "pdr", "delay_mean", "delay_jitter"]
    },
    {
      "id": "n_sw",
      "name": "广播交换机",
      "kind": "switch",
      "x": 520,
      "y": 300
    },
    {
      "id": "n_sink1",
      "name": "收端IED_1",
      "kind": "ied",
      "x": 880,
      "y": 120,
      "apps": [
        { "id": "app2", "role": "SERVER", "protocol": "CUSTOM", "port": 502 }
      ],
      "stats": ["rx_packets", "rx_bytes", "pdr", "delay_mean", "delay_jitter"]
    },
    {
      "id": "n_sink2",
      "name": "收端IED_2",
      "kind": "ied",
      "x": 880,
      "y": 480,
      "apps": [
        { "id": "app3", "role": "SERVER", "protocol": "CUSTOM", "port": 502 }
      ],
      "stats": ["rx_packets"]
    }
  ],
  "links": [
    { "id": "l1", "kind": "csma", "nodeA": "n_src", "nodeB": "n_sw", "dataRate": "10Mbps", "delay": "1ms" },
    { "id": "l2", "kind": "csma", "nodeA": "n_sw", "nodeB": "n_sink1", "dataRate": "10Mbps", "delay": "1ms" },
    { "id": "l3", "kind": "csma", "nodeA": "n_sw", "nodeB": "n_sink2", "dataRate": "10Mbps", "delay": "1ms" }
  ],
  "protocols": [],
  "flows": [
    { "id": "f1", "type": "CBR", "src": "n_src", "dst": "n_sink1", "interval": 0.5, "payloadSize": 64 },
    { "id": "f2", "type": "CBR", "src": "n_src", "dst": "n_sink2", "interval": 0.5, "payloadSize": 64 }
  ],
  "faults": [],
  "halfPhysical": { "taps": [], "physicalNic": "" },
  "hil": { "timestepUs": 100 },
  "run": { "mode": "OFFLINE", "precise": false, "clockSource": "INTERNAL", "stopSeconds": 10, "syncMode": "HARD_LIMIT" }
